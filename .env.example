# URL base de la API del backend (Node.js + Express)
VITE_API_URL=http://localhost:4000/api

# Pantalla de login del sistema de seguridad central
VITE_CENTRAL_URL=http://localhost:5177

# Aplicativo que es este frontend: libreria | almacen | seguridad | clientes
VITE_APP_CODE=libreria

# Solo la app de Seguridad: API del central (logs y accesos)
VITE_CENTRAL_API_URL=http://localhost:4100/api/seguridad

# Dominio de los correos corporativos
VITE_DOMINIO_CORREO=libreriarocio.com
